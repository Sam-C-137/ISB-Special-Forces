      <HintPath>$(SPTRoot)/BepInEx/plugins/WTT-ClientCommonLib/WTT-ClientCommonLib.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <Reference Include="netstandard">
