/*
 * Spawn Configuration system copyright (©) 2025 TacticalToaster
 * This program is free software: you can redistribute it and/or modify
 * I recommend don't change any config if you don't know what it does.
 * Config Notation: Patrol and Checkpoint settings are defined in the following format:
 * "patrolChance", checkpointChance" or "huntChance 100 = 100% chance to spawn the ISB Squad, 50 = 50% chance, etc.
 * "squadCount" or "holdZonesCount": Number of squads spawning
 * "patrolMinSize": 1 = One Boss, Two Specialists and One Regular ISB PMC
 * "patrolMinSize": 2 = One Boss, Two Specialists and Two Regular ISB PMC
 * "patrolMinSize": 3 = One Boss, Two Specialists and Three Regular ISB PMC
 * "patrolMinSize": 4 = One Boss, Two Specialists and Four Regular ISB PMC
 * "patrolMinSize": 5 = One Boss, Two Specialists and Five Regular ISB PMC
 * "checkpointMin": 1 = One Boss, Two Specialists and One Regular ISB PMC
 * "checkpointMin": 2 = One Boss, Two Specialists and Two Regular ISB PMC
 * "checkpointMin": 3 = One Boss, Two Specialists and Three Regular ISB PMC
 * "checkpointMin": 4 = One Boss, Two Specialists and Four Regular ISB PMC
 * "checkpointMin": 5 = One Boss, Two Specialists and Five Regular ISB PMC
 * "huntMin": 1 = One Boss, Two Specialists and One Regular ISB PMC
 * "huntMin": 2 = One Boss, Two Specialists and Two Regular ISB PMC
 * "huntMin": 3 = One Boss, Two Specialists and Three Regular ISB PMC
 * "huntMin": 4 = One Boss, Two Specialists and Four Regular ISB PMC
 * "huntMin": 5 = One Boss, Two Specialists and Five Regular ISB PMC
 * Changing the "patrolMaxSize", "checkpointMax" or "huntMax" values will increase the maximum amount of ISB PMCs that can spawn in range.
 *
 */
