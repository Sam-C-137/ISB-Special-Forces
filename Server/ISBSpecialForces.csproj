<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <SPTRoot Condition="'$(SPTRoot)' == ''">C:\SPTV</SPTRoot>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>ISBSpecialForces</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Library</OutputType>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <Version>2.0.1</Version>
    <AssemblyVersion>2.0.1</AssemblyVersion>
    <FileVersion>2.0.1</FileVersion>
    <OutputPath>bin\$(Configuration)\$(ProjectName)\$(AssemblyName)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AssemblyName>ISBSpecialForces</AssemblyName>
    <AssemblySearchPaths>{HintPathFromItem};$(AssemblySearchPaths)</AssemblySearchPaths>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="db\bots\config\**" />
    <Compile Include="..\Shared\OfficeAccess.cs" Link="OfficeAccess.cs" />
    <Compile Include="..\Shared\OfficeKteBriefing.cs" Link="OfficeKteBriefing.cs" />
    <Compile Include="..\Shared\OfficeRaidOperations.cs" Link="OfficeRaidOperations.cs" />
    <Compile Include="..\Shared\BlackDivisionCheckpointPolicy.cs" Link="BlackDivisionCheckpointPolicy.cs" />
    <Compile Remove="db\bots\types\**" />
    <Content Remove="db\bots\config\**" />
    <Content Remove="db\bots\types\**" />
    <EmbeddedResource Remove="db\bots\config\**" />
    <EmbeddedResource Remove="db\bots\types\**" />
    <None Remove="db\bots\config\**" />
    <None Remove="db\bots\types\**" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="fastJSON5" Version="1.0.4">
      <Private>true</Private>
      <CopyLocal>true</CopyLocal>
      <CopyLocalSatelliteAssemblies>true</CopyLocalSatelliteAssemblies>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <Reference Include="MoreBotsServer">
      <HintPath>$(SPTRoot)/SPT_Runtime/user/mods/MoreBotsServer/MoreBotsServer.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="WTT-ServerCommonLib">
      <HintPath>$(SPTRoot)/SPT_Runtime/user/mods/WTT-ServerCommonLib/WTT-ServerCommonLib.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\Shared\ISBBotTypes.json" LogicalName="ISBSpecialForces.ISBBotTypes.json" />
    <EmbeddedResource Include="..\Shared\ISBSainRoles.json" LogicalName="ISBSpecialForces.ISBSainRoles.json" />
    <None Update="containment_breach_config.jsonc">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="containment_breach_config.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <Compile Include="..\ISBSOFExtras\Scp173Config.cs" Link="Scp173Config.cs" />
    <None Update="nightmare_config.jsonc">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="config.jsonc">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="sain_defaults\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="db\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <ItemGroup>
    <Reference Include="SPTarkov.Common">
      <HintPath>$(SPTRoot)\SPT_Runtime\SPTarkov.Common.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SPTarkov.DI">
      <HintPath>$(SPTRoot)\SPT_Runtime\SPTarkov.DI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SPTarkov.Server.Core">
      <HintPath>$(SPTRoot)\SPT_Runtime\SPTarkov.Server.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SPTarkov.Reflection">
      <HintPath>$(SPTRoot)\SPT_Runtime\SPTarkov.Reflection.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SemanticVersioning">
      <HintPath>$(SPTRoot)\SPT_Runtime\SemanticVersioning.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(SPTRoot)\SPT_Runtime\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <Target Name="CopyEnumExtensions" AfterTargets="Build">
    <Copy SourceFiles="$(ProjectDir)EnumExtensions\ISBEnums.json" DestinationFolder="$(TargetDir)EnumExtensions\com.samc137.isbspecialforces" />
  </Target>
  <ItemGroup>
    <Reference Include="SPTarkov.Server.Web">
      <HintPath>$(SPTRoot)\SPT_Runtime\SPTarkov.Server.Web.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Content Remove="Web\**\*" />
    <None Update="Web\**\*" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
    <EmbeddedResource Include="Web\index.html" LogicalName="ISBSpecialForces.Web.index.html" />
    <EmbeddedResource Include="Web\app.js" LogicalName="ISBSpecialForces.Web.app.js" />
    <EmbeddedResource Include="Web/Defaults/config.jsonc" LogicalName="ISBSpecialForces.Web.Defaults.config.jsonc" />
    <EmbeddedResource Include="Web/Defaults/containment_breach_config.jsonc" LogicalName="ISBSpecialForces.Web.Defaults.containment_breach_config.jsonc" />
    <EmbeddedResource Include="Web/Defaults/audio.cfg" LogicalName="ISBSpecialForces.Web.Defaults.audio.cfg" />

    <EmbeddedResource Include="Web\style.css" LogicalName="ISBSpecialForces.Web.style.css" />
  </ItemGroup>
  <PropertyGroup>
    <DefineConstants>$(DefineConstants);ISB_SPT41</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\Shared\ISBDogtagLevels.cs" Link="ISBDogtagLevels.cs" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Web\isb-logo.png" LogicalName="ISBSpecialForces.Web.isb-logo.png" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Services/AmnestyQuest.json" LogicalName="ISBSpecialForces.AmnestyQuest.json" />
    <EmbeddedResource Include="db/AchievementAssorts.json" LogicalName="ISBSpecialForces.AchievementAssorts.json" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\Shared\GhostBotVariant.cs" Link="GhostBotVariant.cs" />
  </ItemGroup>
  <PropertyGroup Condition="'$(ISBFinalBeta)' == 'true'">
    <DefineConstants>$(DefineConstants);ISB_FINAL_BETA</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(ISBFinalBeta)' == 'true'">
    <EmbeddedResource Remove="Web\**\*" />
  </ItemGroup>
  <ItemGroup>
  </ItemGroup>
  <ItemGroup><Compile Include="../Shared/VipperPoisonIdentity.cs" Link="VipperPoisonIdentity.cs" /></ItemGroup>
</Project>
