<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <SPTRoot Condition="'$(SPTRoot)' == ''">C:\SPTIV</SPTRoot>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>ISBSpecialForces</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Library</OutputType>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <Version>1.1.0</Version>
    <AssemblyVersion>1.1.0</AssemblyVersion>
    <FileVersion>1.1.0</FileVersion>
    <OutputPath>bin\$(Configuration)\$(ProjectName)\$(AssemblyName)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AssemblyName>ISBSpecialForces</AssemblyName>
    <AssemblySearchPaths>{HintPathFromItem};$(AssemblySearchPaths)</AssemblySearchPaths>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="db\bots\config\**" />
    <Compile Include="..\Shared\OfficeAccess.cs" Link="OfficeAccess.cs" />
    <Compile Include="..\Shared\OfficeKteBriefing.cs" Link="OfficeKteBriefing.cs" />
    <Compile Include="..\Shared\OfficeRaidOperations.cs" Link="OfficeRaidOperations.cs" />
    <Compile Include="..\Shared\BlackDivisionCheckpointPolicy.cs" Link="BlackDivisionCheckpointPolicy.cs" />
    <Compile Remove="db\bots\types\**" />
    <Content Remove="db\bots\config\**" />
    <Content Remove="db\bots\types\**" />
    <EmbeddedResource Remove="db\bots\config\**" />
    <EmbeddedResource Remove="db\bots\types\**" />
    <None Remove="db\bots\config\**" />
    <None Remove="db\bots\types\**" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="fastJSON5" Version="1.0.4">
      <Private>true</Private>
      <CopyLocal>true</CopyLocal>
      <CopyLocalSatelliteAssemblies>true</CopyLocalSatelliteAssemblies>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <Reference Include="MoreBotsServer">
      <HintPath>$(SPTRoot)/SPT/user/mods/MoreBotsServer/MoreBotsServer.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="WTT-ServerCommonLib">
      <HintPath>$(SPTRoot)/SPT/user/mods/WTT-ServerCommonLib/WTT-ServerCommonLib.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\Shared\ISBBotTypes.json" LogicalName="ISBSpecialForces.ISBBotTypes.json" />
    <None Update="containment_breach_config.jsonc">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="containment_breach_config.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <Compile Include="..\ISBSOFExtras\Scp173Config.cs" Link="Scp173Config.cs" />
    <None Update="nightmare_config.jsonc">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="config.jsonc">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="sain_defaults\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="db\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <ItemGroup>
    <Reference Include="SPTarkov.Common">
      <HintPath>$(SPTRoot)\SPT\SPTarkov.Common.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SPTarkov.DI">
      <HintPath>$(SPTRoot)\SPT\SPTarkov.DI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SPTarkov.Server.Core">
      <HintPath>$(SPTRoot)\SPT\SPTarkov.Server.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SPTarkov.Reflection">
      <HintPath>$(SPTRoot)\SPT\SPTarkov.Reflection.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SemanticVersioning">
      <HintPath>$(SPTRoot)\SPT\SemanticVersioning.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(SPTRoot)\SPT\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <Reference Include="SPTarkov.Server.Web">
      <HintPath>$(SPTRoot)\SPT\SPTarkov.Server.Web.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <EmbeddedResource Include="Web\index.html" LogicalName="ISBSpecialForces.Web.index.html" />
    <EmbeddedResource Include="Web\app.js" LogicalName="ISBSpecialForces.Web.app.js" />
    <EmbeddedResource Include="Web\style.css" LogicalName="ISBSpecialForces.Web.style.css" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\Shared\ISBDogtagLevels.cs" Link="ISBDogtagLevels.cs" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Web\isb-logo.png" LogicalName="ISBSpecialForces.Web.isb-logo.png" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Services/AmnestyQuest.json" LogicalName="ISBSpecialForces.AmnestyQuest.json" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\Shared\GhostBotVariant.cs" Link="GhostBotVariant.cs" />
  </ItemGroup>
  <PropertyGroup Condition="'$(ISBFinalBeta)' == 'true'">
    <DefineConstants>$(DefineConstants);ISB_FINAL_BETA</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(ISBFinalBeta)' == 'true'">
    <EmbeddedResource Remove="Web\**\*" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="db/EventQuestIdMigration.json" LogicalName="ISBSpecialForces.EventQuestIdMigration" />
  </ItemGroup>
</Project>
