<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>ISBSpecialForces</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Library</OutputType>
    <Version>1.0.3</Version>
    <AssemblyVersion>1.0.3</AssemblyVersion>
    <FileVersion>1.0.3</FileVersion>
    <OutputPath>bin\$(Configuration)\$(ProjectName)\$(AssemblyName)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AssemblyName>ISBSpecialForces</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="db\bots\config\**" />
    <Compile Remove="db\bots\types\**" />
    <Content Remove="db\bots\config\**" />
    <Content Remove="db\bots\types\**" />
    <EmbeddedResource Remove="db\bots\config\**" />
    <EmbeddedResource Remove="db\bots\types\**" />
    <None Remove="db\bots\config\**" />
    <None Remove="db\bots\types\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="fastJSON5" Version="1.0.4">
      <Private>true</Private>
      <CopyLocal>true</CopyLocal>
      <CopyLocalSatelliteAssemblies>true</CopyLocalSatelliteAssemblies>
    </PackageReference>
    <PackageReference Include="SPTarkov.Common" Version="4.0.7" />
    <PackageReference Include="SPTarkov.DI" Version="4.0.7" />
    <PackageReference Include="SPTarkov.Server.Core" Version="4.0.7" />
    <PackageReference Include="SPTarkov.Reflection" Version="4.0.7" />
    <PackageReference Include="WTT-ClientCommonLib" Version="2.0.5" />
    <PackageReference Include="WTT-ServerCommonLib" Version="2.0.5" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="MoreBotsPlugin">
      <HintPath>Refer\MoreBotsPlugin.dll</HintPath>
    </Reference>
    <Reference Include="MoreBotsPrepatch">
      <HintPath>Refer\MoreBotsPrepatch.dll</HintPath>
    </Reference>
    <Reference Include="MoreBotsServer">
      <HintPath>Refer\MoreBotsServer.dll</HintPath>
    </Reference>
    <Reference Include="WTT-ClientCommonLib">
      <HintPath>..\..\..\..\SPT2\BepInEx\plugins\WTT-ClientCommonLib\WTT-ClientCommonLib.dll</HintPath>
    </Reference>
    <Reference Include="WTT-ServerCommonLib">
      <HintPath>..\..\..\SPT\user\mods\WTT-ServerCommonLib\WTT-ServerCommonLib.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Update="config.jsonc">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="db\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>