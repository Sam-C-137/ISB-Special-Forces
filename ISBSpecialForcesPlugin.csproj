  <Target Name="PostBuild" AfterTargets="Build" Condition="'$(DeployToGame)' == 'true'">
    <PropertyGroup>
      <SPTRoot Condition="'$(SPTRoot)' == ''">C:\SPTIV</SPTRoot>
      <ISBPluginInstallDirectory>$(SPTRoot)\BepInEx\plugins</ISBPluginInstallDirectory>
    </PropertyGroup>
    <MakeDir Directories="$(ISBPluginInstallDirectory)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ISBPluginInstallDirectory)" SkipUnchangedFiles="true" />
  </Target>
  <ItemGroup>
    <Compile Include="Shared\ISBDogtagLevels.cs" Link="ISBDogtagLevels.cs" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="netstandard">
      <HintPath>$(SPTRoot)\EscapeFromTarkov_Data\Managed\netstandard.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <Compile Include="Shared\GhostBotVariant.cs" Link="GhostBotVariant.cs" />
  </ItemGroup>
<ItemGroup><Compile Include="Plugin/**/*.cs" Exclude="Plugin/bin/**;Plugin/obj/**" /></ItemGroup></Project>
