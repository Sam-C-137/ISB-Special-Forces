<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblySearchPaths>{HintPathFromItem};$(AssemblySearchPaths)</AssemblySearchPaths>
    <SPTRoot Condition="'$(SPTRoot)' == ''">C:\SPTIV</SPTRoot>
    <TargetFramework>net472</TargetFramework>
    <DefineConstants>$(DefineConstants);SPT40</DefineConstants>
    <AssemblyName>ISB-SpecialForces</AssemblyName>
    <Description>ISB Special Forces client plugin.</Description>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <Configurations>Debug;Release</Configurations>
    <RootNamespace>ISBSpecialForces</RootNamespace>
    <Version>1.1.0</Version>
    <AssemblyVersion>1.1.0</AssemblyVersion>
    <FileVersion>1.1.0</FileVersion>
  </PropertyGroup>
